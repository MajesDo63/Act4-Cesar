# Proveedor del modelo: gemini | groq | ollama | fake
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_URL=http://localhost:11434

# Embeddings: gemini | ollama | local | hash (hash = sin red, solo para pruebas)
EMB_PROVIDER=hash
TOKEN_SECRET=
API_URL=http://127.0.0.1:8004
LLM_TIMEOUT=60
LLM_RETRIES=1
LLM_INTERVALO_SEG=6
